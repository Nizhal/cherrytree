msgstr "ஒவ்வொரு நிலைக்கும் வெவ்வேறு சின்னங்களைப் பயன்படுத்து"

msgid "No Icon"
msgstr "சின்னம் இல்லை"

msgid "Hide Right Side Auxiliary Icon"
msgstr "வலது பக்க துணைச் சின்னத்தை மறை"

msgid "Default Text Nodes Icons"
msgstr "இயல்புநிலை உரை முனைச் சின்னங்கள்"

msgid "Restore Expanded/Collapsed Status"
msgstr "விரிவாக்கப்பட்ட/சுருக்கப்பட்ட நிலையை மீட்டமை"

msgid "Expand all Nodes"
msgstr "அனைத்து முனைகளையும் விரிவுபடுத்து"

msgid "Collapse all Nodes"
msgstr "அனைத்தையும் முனைகளையும் சுருக்கு"

msgid "Nodes in Bookmarks Always Visible"
msgstr "புக்மார்க்குகளில் உள்ள முனைகள் எப்போதும் தெரியும் வகையில் இருக்க வேண்டும்"

msgid "Nodes Status at Startup"
msgstr "தொடக்கத்தில் முனைகளின் நிலை"

msgid "Tree Nodes Names Wrapping Width"
msgstr "கிளை அமைப்பின் முனைகளின் பெயர்கள் மடிக்கப்படும் அகலம்"

msgid "Display Tree on the Right Side"
msgstr "கிளை அமைப்பை வலது பக்கத்தில் காட்டு"

msgid "Move Focus to Text at Mouse Click"
msgstr "சுட்டி மூலம் கிளிக் செய்யும்போது உரையின் மீது கவனத்தை மாற்று"

msgid "Expand Node at Mouse Click"
msgstr "சுட்டி மூலம் கிளிக் செய்யும்போது முனையை விரிவுபடுத்து"

#, c-format
msgid "'%s' is Not a Valid Archive"
msgstr "'%s' என்பது செல்லுபடியாகும் காப்பகம் அல்ல"

msgid "Writing to Disk..."
msgstr "வட்டில் எழுதப்படுகிறது..."

#, c-format
msgid "You Have No Write Access to %s"
msgstr "உங்களுக்கு %s-இல் எழுதும் அனுமதி இல்லை"

#, c-format
msgid "Enter Password for %s"
msgstr "%s-க்கான கடவுச்சொல்லை உள்ளிடவும்"

msgid "Failed integrity check of the saved document. Try File-->Save As"
msgstr "சேமிக்கப்பட்ட ஆவணத்தின் ஒருமைப்பாடு சரிபார்ப்பு (integrity check) தோல்வியடைந்தது. கோப்பு -> இவ்வாறு சேமி என்பதை முயற்சிக்கவும்"

msgid "Failed to encrypt the file"
msgstr "கோப்பை மறைகுறியாக்கம் செய்வதில் தோல்வி"

msgid "A Restore From Backup Was Necessary For:"
msgstr "இதற்கு காப்புப்பிரதியிலிருந்து மீட்டமைத்தல் அவசியமாக இருந்தது:"

#, c-format
msgid "The database file %s is corrupt, see log for more details."
msgstr "தரவுத்தளக் கோப்பு %s சிதைந்துள்ளது; கூடுதல் விவரங்களுக்குப் பதிவை பார்க்கவும்."

#, c-format
msgid ""
"%s write failed - file is missing. Reattach USB drive or shared resource."
msgstr "%s-இல் எழுதுதல் தோல்வியடைந்தது - கோப்பு காணப்படவில்லை. USB இயக்கி அல்லது பகிரப்பட்ட வளத்தை மீண்டும் இணைக்கவும்."

#, c-format
msgid "%s write failed - is file blocked by a sync program?"
msgstr "%s-இல் எழுதுதல் தோல்வியடைந்தது - ஒத்திசைவு நிரலால் (sync program) கோப்பு தடுக்கப்பட்டுள்ளதா?"

#, c-format
msgid ""
"%s reopen failed - file is missing. Reattach USB drive or shared resource."
msgstr "%s-ஐ மீண்டும் திறப்பது தோல்வியடைந்தது - கோப்பு காணப்படவில்லை. USB இயக்கி அல்லது பகிரப்பட்ட வளத்தை மீண்டும் இணைக்கவும்."

msgid "CherryTree Hierarchical Note Taking"
msgstr "CherryTree படிநிலை குறிப்பு எடுத்தல் மென்பொருள்"

msgid "_Exit CherryTree"
msgstr "CherryTree-யிலிருந்து வெளியேறு"

msgid "HTML Document"
msgstr "HTML ஆவணம்"

msgid "Markdown Document"
msgstr "Markdown ஆவணம்"

msgid "Mempad Document"
msgstr "Mempad ஆவணம்"

msgid "Treepad Document"
msgstr "மரப்பலகை ஆவணம்"

msgid "Leo Document"
msgstr "லியோ ஆவணம்"

msgid "Are you sure to Reset to Default?"
msgstr "இயல்புநிலைக்கு மீட்டமைக்க உறுதியாக உள்ளீர்களா?"
